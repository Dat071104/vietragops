    "suite_result": "612 passed, 2 warnings",
    "suite_basetemp_policy": "External basetemp required by RISK-0027; exact temp directory is not part of the scientific artifact."
  },
  "analysis_plan": {
    "c1": {
      "raw_cases": [
        "G07-G-0127",
        "G07-G-0130",
        "G07-G-0133",
        "G07-G-0136",
        "G07-G-0139"
      ],
      "compare_each_baseline_arm": true,
      "inspect_scoring_code": "research/gate07/metrics/scoring.py",
      "preserve_register_history": true
    },
    "c2": {
      "enumerate_all_drift_families_from_frozen_auditor_oracle": true,
      "report_fields": [
        "total_pairs",
        "total_graded_cases",
        "reachable",
        "unreachable_target_absent",
        "unreachable_convention_unobservable",
        "retained_after_repair"
      ],
      "hidden_required_field_defaults": "Classify each as item-unreachable or derivable from declared information rights without editing frozen artifacts."
    },
    "c3": {
      "metric": "first-attempt success proportion",
      "planned_surfaces": {
        "argument_split": 40,
        "tool_replacement": 15,
        "pooled_retained": 55
      }
    }
  },
  "power_analysis": {
    "test": "Two-sided two-sample normal-approximation test for independent proportions with equal n per arm and no continuity correction.",
    "alpha": 0.05,
    "target_power": 0.8,
    "practically_meaningful_absolute_difference": 0.2,
    "baseline_definition": "For each family/surface, p_bar is the observed pooled first-attempt success rate across the two frozen Gate 07 baseline arms on the retained scoreable cases; the same deterministic rule applies to the pooled retained set.",
    "alternative_definition": "For an absolute difference d, evaluate p_low=p_bar-d/2 and p_high=p_bar+d/2 when both are in [0,1].",
    "mde_definition": "Smallest d in [0,1] whose calculated two-sided power reaches target_power, reported as an absolute proportion-point difference.",
    "required_n_definition": "Smallest integer n per arm whose power reaches target_power for the pre-registered 0.20 absolute difference.",
    "confidence_interval": "95% Wilson interval for each observed arm rate and the pooled rate; report full width and half-width.",
    "decision_rule": {
      "go": "GO only if argument_split and tool_replacement each have retained n > 0, each has MDE <= 0.20 and required n per arm <= its retained n, and the pooled retained set also satisfies the same MDE/required-n thresholds.",
      "cancel": "CANCEL if any planned family or the pooled retained set fails the GO conditions, or if a required surface has n=0.",
      "interpretation": "The pooled surface cannot rescue a family-level failure; n=15 is judged against the pre-registered 0.20 practical effect band."
    }
  },
